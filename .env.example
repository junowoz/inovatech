# Inovatech. Copy to .env: cp .env.example .env
# Local settings. Production values live in the Cloudflare Worker config and
# build environment (Workers Builds, git push main).

# Canonical site URL (SEO metadata, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base path for media served from the R2 "inovatech/" prefix (see lib/storage.ts,
# app/midia/[...path]/route.ts). Same-origin in every environment — no need
# to change this locally or in production.
NEXT_PUBLIC_MIDIA_URL=/midia/

# Public contact links shown in footer and signup pages.
NEXT_PUBLIC_CONTACT_EMAIL=inbox@junowoz.com

# --- Local dev only ---
# `pnpm dev` runs on plain `next dev`; D1/R2 bindings come from wrangler.jsonc
# through miniflare (initOpenNextCloudflareForDev in next.config.ts) — no
# extra env needed for that. Run `pnpm db:migrate:local` once to create the
# local SQLite D1 database from ./drizzle.

# --- Optional: remote D1 access for `drizzle-kit studio` / `db:generate` ---
# Not needed for the normal generate + `wrangler d1 migrations apply` flow.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_D1_TOKEN=

# --- Production only (set in Cloudflare Workers Builds > Build variables) ---
# NEXT_PUBLIC_* values are embedded into the Next.js bundle at build time.
# Keep these in sync with the public vars in wrangler.jsonc.
# NEXT_PUBLIC_SITE_URL=https://inovatech.junowoz.com
# NEXT_PUBLIC_MIDIA_URL=/midia/
# NEXT_PUBLIC_CONTACT_EMAIL=inbox@junowoz.com
# Google Analytics measurement id (analytics disabled if unset).
# NEXT_PUBLIC_GA_ID=
